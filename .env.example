# --- MongoDB Atlas (required) ---
# Create a cluster at https://cloud.mongodb.com → Connect → Drivers → copy the
# mongodb+srv:// connection string. Database name must be business_verification.
# Atlas → Network Access → ADD IP ADDRESS → "Allow access from anywhere"
# (0.0.0.0/0) so Vercel's serverless functions can connect.
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.<your-id>.mongodb.net/business_verification?retryWrites=true&w=majority
MONGODB_DB_NAME=business_verification

# If mongodb+srv:// fails with querySrv ECONNREFUSED on your machine (broken
# local DNS: VPN/adblock drivers intercepting queries), use the direct form
# instead — no SRV lookup needed. Get hosts + replicaSet via:
#   nslookup -type=SRV _mongodb._tcp.<cluster-host>
# then: mongodb://<user>:<password>@<shard0>:27017,<shard1>:27017,<shard2>:27017/business_verification?ssl=true&replicaSet=<setName>&authSource=admin&retryWrites=true&w=majority

# --- Auth (required) ---
# Long random string (≥32 chars). Generate: openssl rand -base64 48
AUTH_SECRET=change-me-to-a-long-random-string-min-32-chars

# --- Master account (recommended) ---
# Username of the untouchable master admin. It cannot be deleted, deactivated,
# demoted, or password-reset by any other ADMIN (protects against lockout).
# Set this to your first admin's username, locally AND on Vercel.
MASTER_ADMIN_USERNAME=bvp-app

# --- Public app identity ---
NEXT_PUBLIC_APP_NAME=Business Verification Portal
# Local dev: http://localhost:3000
# Vercel: set to https://<your-project>.vercel.app (or custom domain).
# If left empty in production, the app falls back to Vercel's VERCEL_URL.
NEXT_PUBLIC_APP_URL=https://tan-hung-no-drugs-project.vercel.app

# --- File storage ---
# Vercel serverless has an ephemeral filesystem, so certificate uploads persist
# via Vercel Blob: Dashboard → Storage → Blob → Create → copy READ_WRITE token.
# If unset, the app uses a non-persistent local stub (dev only).
BLOB_READ_WRITE_TOKEN=
# Alternative S3-compatible storage (optional, wired via lib/storage.ts):
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=certificates

# --- DNS workaround (local dev only, optional) ---
# If /api/health reports db:down with ECONNREFUSED on DNS (some ISPs/routers
# hijack port 53 to the system DNS), force Node to use working resolvers:
# DNS_SERVERS=1.1.1.1,1.0.0.1
